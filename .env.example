# Smart Cataloguing Pipeline - Environment Configuration Template
# Copy this file to .env and customize as needed

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Open Library API URL (default: https://openlibrary.org/api/books)
# OPENLIBRARY_API_URL=https://openlibrary.org/api/books

# Google Books API URL (default: https://www.googleapis.com/books/v1/volumes)
# GOOGLEBOOKS_API_URL=https://www.googleapis.com/books/v1/volumes

# Google Books API Key (optional, increases rate limits from 1000 to 100,000 requests/day)
# Get your key at: https://console.cloud.google.com/apis/credentials
# GOOGLEBOOKS_API_KEY=your_api_key_here

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================

# Request timeout in seconds (default: 3)
# REQUEST_TIMEOUT=3

# Maximum retries for failed API calls (default: 1)
# MAX_RETRIES=1

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server host (default: 0.0.0.0)
# HOST=0.0.0.0

# Server port (default: 8000)
# PORT=8000

# Enable auto-reload for development (default: False)
# RELOAD=False

# Environment: development or production (default: development)
# ENVIRONMENT=development

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable Open Library as primary source (default: True)
# ENABLE_OPENLIBRARY=True

# Enable/disable Google Books as fallback (default: True)
# ENABLE_GOOGLEBOOKS=True

# Enable detailed API response logging (default: True)
# ENABLE_API_LOGGING=True

# ============================================================================
# AI ENHANCEMENT (LangSearch + Gemini)
# ============================================================================

# Set to True to enable the post-approval enhancement pipeline (default: True)
# ENABLE_AI_ENHANCEMENT=True

# Google Generative AI (Gemini) API key (required for enhancement/embeddings)
# Get a key: https://aistudio.google.com/
# GOOGLE_API_KEY=your_gemini_api_key_here

# LangSearch API key (required for web search)
# LANGSEARCH_KEY=your_langsearch_key_here

# Strict validation (fail startup if AI keys are missing). Default: False
# STRICT_AI_VALIDATION=False

# Output directories (optional overrides)
# ENHANCED_BOOKS_DIR=data/enhanced_books
# FAISS_INDEX_DIR=data/faiss_index

# ============================================================================
# FUTURE CONFIGURATION (Step 2+)
# ============================================================================

# Redis configuration (for future async implementation)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Celery configuration (for future async implementation)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# DATABASE CONFIGURATION (Required for Librarian Confirmation Feature)
# ============================================================================

# PostgreSQL database connection URL
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://postgres:mypassword@localhost:5432/slms
# Default if not set: postgresql://postgres:password@localhost:5432/slms
DATABASE_URL=postgresql://postgres:password@localhost:5432/slms

# Note: Ensure PostgreSQL is installed and the database exists
# Create database: createdb slms
# Run schema: psql -U postgres -d slms -f Schema/db_files.sql
